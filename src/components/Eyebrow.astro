---
/** Small uppercase label with the three-line mark, above section headings. */
import Icon from './Icon.astro';
interface Props {
  dark?: boolean;
  class?: string;
}
const { dark = false, class: cls = '' } = Astro.props;
---

<p class={`flex items-center gap-2.5 font-heading text-xs font-bold tracking-[0.16em] uppercase ${dark ? 'text-white/80' : 'text-navy'} ${cls}`}>
  <Icon name="lines" class="size-4" />
  <slot />
</p>
