---
/**
 * Where we go in a district: answer first, client-confirmed hospitals (destinations only, no
 * logos, no partner wording), city areas and upazilas as plain-text chips (no links, no thin
 * sub-pages), and the landmark line. Remote upazilas show only once their coverage is verified.
 */
import Icon from '../Icon.astro';
import type { DistrictPage } from '../../data/district-pages/schema';
import type { DistrictFacts } from '../../data/districts';
interface Props {
  pickup: DistrictPage['pickup'];
  facts: DistrictFacts;
  /** True once pickup anywhere in the district is verified (switches the H2 and answer). */
  fullCoverage: boolean;
}
const { pickup, facts, fullCoverage } = Astro.props;
const hospitals = facts.destinations.filter((d) => d.verified);
const upazilas = facts.upazilas.filter((u) => !u.remote || facts.remoteUpazilas.verified);
const chip = 'inline-flex min-h-11 items-center gap-2 rounded-full border border-(--line) bg-(--card) px-4 py-2 text-(--ink)';
---

<section class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[1240px] px-4 md:px-6">
    <div class="max-w-3xl">
      <p class="eyebrow-warm">{pickup.eyebrow}</p>
      <h2 class="mt-4">{fullCoverage ? pickup.h2 : pickup.h2Partial}</h2>
      <p class="mt-6 text-xl text-(--ink)">{fullCoverage ? pickup.answer : pickup.answerPartial}</p>
    </div>

    {
      hospitals.length > 0 && (
        <>
          <h3 class="mt-14">{pickup.hospitalsH3}</h3>
          <p class="mt-3 text-lg">{pickup.hospitalsLead}</p>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {hospitals.map((h) => (
              <li class="flex gap-3 rounded-[22px] bg-(--card) p-4 soft-shadow">
                <Icon name="building" class="mt-0.5 size-5 shrink-0 text-(--blue-ink)" />
                <span>
                  <span class="block text-(--ink)">{h.name}</span>
                  <span class="block text-sm">{h.area}</span>
                </span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <div class:list={['mt-14 grid gap-12 [&>*]:min-w-0', facts.areas.length > 0 && 'lg:grid-cols-2']}>
      {facts.areas.length > 0 && pickup.areasH3 && (
      <div>
        <h3>{pickup.areasH3}</h3>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            facts.areas.map((a) => (
              <li class={chip}>
                <Icon name="pin" class="size-4 shrink-0 text-(--blue-ink)" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
      )}
      <div>
        <h3>{pickup.upazilasH3}</h3>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            upazilas.map((u) => (
              <li class={chip}>
                <Icon name="route" class="size-4 shrink-0 text-(--blue-ink)" />
                {u.name}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="serif mt-12 text-xl text-(--blue-ink) italic" data-shared>{pickup.landmarkLine}</p>
  </div>
</section>
