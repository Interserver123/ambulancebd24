---
/**
 * The route between Dhaka and a district: answer first, a small custom SVG route diagram
 * (line and dots in brand colours, no map screenshot), what affects the journey, the checked
 * road distance (only once distanceChecked) and the "no travel-time promise" line.
 * Two SVG layouts: horizontal from md up, vertical on phones (labels stay readable at 360px).
 */
import Icon from '../Icon.astro';
import type { DistrictPage } from '../../data/district-pages/schema';
interface Props {
  route: DistrictPage['route'];
  /** Checked road distance in km, or undefined while not checked. */
  km?: number;
  /** Page of the on-route district, if published. */
  onRouteHref?: string;
}
const { route, km, onRouteHref } = Astro.props;
const stops = route.stops;
const n = stops.length;
// Horizontal layout
const W = 760;
const padX = 90;
const x = (i: number) => padX + (i * (W - 2 * padX)) / (n - 1);
// Vertical layout
const H = 70 * (n - 1) + 60;
const y = (i: number) => 30 + i * 70;
const isEnd = (i: number) => i === 0 || i === n - 1;
---

<section class="relative overflow-hidden bg-(--tint) py-20 md:py-28">
  <svg class="absolute top-0 left-0 h-10 w-full text-(--page) md:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v34c-180 30-360 46-540 30S540 18 360 30 120 70 0 54Z"></path></svg>
  <div class="relative mx-auto max-w-[1240px] px-4 pt-6 md:px-6">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-6">
        <p class="eyebrow-warm">{route.eyebrow}</p>
        <h2 class="mt-4">{route.h2}</h2>
      </div>
      <p class="text-xl text-(--ink) lg:col-span-6">{route.answer}</p>
    </div>

    <figure class="pebble mt-12 rounded-[40px] bg-(--card) p-6 md:p-10">
      <svg class="hidden h-auto w-full md:block" viewBox={`0 0 ${W} 150`} role="img" aria-label={route.diagramAlt}>
        <title>{route.diagramAlt}</title>
        <line x1={x(0)} y1="60" x2={x(n - 1)} y2="60" stroke="var(--blue)" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 10"></line>
        {
          stops.map((s, i) => (
            <g>
              <circle cx={x(i)} cy="60" r={isEnd(i) ? 13 : 9} fill={isEnd(i) ? 'var(--ink)' : 'var(--card)'} stroke="var(--blue)" stroke-width="4" />
              <text x={x(i)} y="105" text-anchor="middle" fill="var(--ink)" font-size="17" font-weight={isEnd(i) ? 700 : 500}>
                {s.name}
              </text>
              {s.note && (
                <text x={x(i)} y="128" text-anchor="middle" fill="var(--gray-ink)" font-size="13">
                  {s.note}
                </text>
              )}
            </g>
          ))
        }
      </svg>
      <svg class="mx-auto block h-auto w-full max-w-[300px] md:hidden" viewBox={`0 0 300 ${H}`} role="img" aria-label={route.diagramAlt}>
        <title>{route.diagramAlt}</title>
        <line x1="40" y1={y(0)} x2="40" y2={y(n - 1)} stroke="var(--blue)" stroke-width="4" stroke-linecap="round" stroke-dasharray="2 10"></line>
        {
          stops.map((s, i) => (
            <g>
              <circle cx="40" cy={y(i)} r={isEnd(i) ? 13 : 9} fill={isEnd(i) ? 'var(--ink)' : 'var(--card)'} stroke="var(--blue)" stroke-width="4" />
              <text x="72" y={y(i) + 6} fill="var(--ink)" font-size="18" font-weight={isEnd(i) ? 700 : 500}>
                {s.name}
              </text>
              {s.note && (
                <text x="72" y={y(i) + 26} fill="var(--gray-ink)" font-size="13">
                  {s.note}
                </text>
              )}
            </g>
          ))
        }
      </svg>
    </figure>

    <div class="mt-12 grid gap-10 lg:grid-cols-12 [&>*]:min-w-0">
      <div class="lg:col-span-7">
        <h3>{route.factorsH3}</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          {
            route.factors.map((f) => (
              <li class="flex gap-3 rounded-[20px] bg-(--card) px-4 py-3 text-(--ink)">
                <Icon name="route" class="mt-0.5 size-5 shrink-0 text-(--blue-ink)" />
                {f}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="space-y-4 text-lg lg:col-span-5 lg:pt-12">
        {km && <p class="text-(--ink)">{route.distanceLine.replace('{km}', String(km))}</p>}
        <p data-shared>{route.etaLine}</p>
        {
          route.onRoute && onRouteHref && (
            <p>
              {route.onRoute.lead}{' '}
              <a href={onRouteHref} class="font-medium text-(--blue-ink) underline underline-offset-4">{route.onRoute.anchor}</a>.
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
