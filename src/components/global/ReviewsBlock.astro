---
/**
 * Reviews block, on every page (via SiteLayout). Always renders, with the GBP link.
 * 1. Approved reviews from src/content/reviews (tag matches first, then any), verbatim.
 * 2. Otherwise the third-party Google reviews widget (business.gbp.reviewsWidget),
 *    loaded only when the section is near (script in SiteLayout).
 * Never review or star-rating schema.
 */
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { business, shown } from '../../data/business';
import { ui, type Lang } from '../../data/ui';

interface Props {
  eyebrow: string;
  h2Lead: string;
  h2Accent: string;
  /** Service keys or area slugs in priority order; matching reviews are shown first. */
  tags?: string[];
  max?: number;
  lang?: Lang;
}
const { eyebrow, h2Lead, h2Accent, tags = [], max = 3, lang = 'en' } = Astro.props;
const t = ui[lang];

const approved = (await getCollection('reviews', (r) => r.data.approved)).map((r) => r.data);
// Lower rank = better match: first matching tag in the page's priority list, then the rest.
const rank = (r: (typeof approved)[number]) => {
  const i = tags.findIndex((tag) => r.tags.includes(tag));
  return i === -1 ? tags.length : i;
};
// Same tag rank: a review written in the page language comes first (Bangla quote first on Bangla pages).
const sameLang = (r: (typeof approved)[number]) => (r.lang === lang ? 0 : 1);
const items = [...approved].sort((a, b) => rank(a) - rank(b) || sameLang(a) - sameLang(b)).slice(0, max);
const widget = items.length ? undefined : shown(business.gbp.reviewsWidget);

/** "Md. Ali Hossain" -> "Md. Ali", "Sumon Babu" -> "Sumon". */
const firstName = (name: string) => {
  const parts = name.split(/\s+/);
  return /^md\.?$/i.test(parts[0] ?? '') ? parts.slice(0, 2).join(' ') : parts[0];
};
const monthYear = (ym?: string) =>
  ym ? new Date(`${ym}-01T00:00:00Z`).toLocaleDateString(t.dateLocale, { month: 'short', year: 'numeric', timeZone: 'UTC' }) : undefined;
const tilt = ['-rotate-1', 'rotate-1 lg:mt-10', '-rotate-[0.5deg]'];
---

<section class="relative py-20 md:py-28" aria-labelledby="reviews-h2">
  <div class="mx-auto max-w-[1240px] px-4 md:px-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow-warm">{eyebrow}</p>
        <h2 id="reviews-h2" class="mt-4">{h2Lead} <em>{h2Accent}</em></h2>
        {items.length > 0 && <p class="mt-2 italic">{t.reviews.sub}</p>}
      </div>
      <a href={business.gbp.reviewsListUrl} class="inline-flex items-center gap-2 font-medium text-(--blue-ink) underline underline-offset-4" rel="noopener">
        {t.reviews.allOurs}
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>

    {
      items.length > 0 && (
        <ul class="mt-12 grid gap-6 md:grid-cols-3">
          {items.map((r, i) => (
            <li class={`reveal pebble flex flex-col rounded-[32px] bg-(--card) p-7 ${tilt[i % tilt.length]}`}>
              <span class="serif text-6xl leading-none text-(--blue)" aria-hidden="true">“</span>
              <blockquote lang={r.lang} class="serif mt-2 grow text-xl leading-snug text-(--ink)">
                <p>{r.text}</p>
              </blockquote>
              <p class="mt-6 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                <span class="font-semibold text-(--ink)">{firstName(r.author)}</span>
                {r.stars && (
                  <span class="flex text-(--blue-ink)" aria-label={`${r.stars} stars`}>
                    {Array.from({ length: r.stars }, () => <Icon name="star" class="size-3.5 fill-current" />)}
                  </span>
                )}
                {monthYear(r.date) && <span>· {monthYear(r.date)}</span>}
                <span>· {t.reviews.source}</span>
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {widget && <div class="mt-12 min-h-[320px]" data-lazy-widget={widget.scriptSrc} data-widget-mount={widget.mountHtml} role="region" aria-label={t.reviews.widgetLabel} />}

    {
      !items.length && !widget && (
        <a href={business.gbp.reviewsListUrl} class="pebble mt-12 flex items-center gap-4 rounded-[28px] bg-(--card) p-6 no-underline" rel="noopener">
          <span class="blob-a flex size-12 shrink-0 items-center justify-center bg-(--blue-soft) text-(--blue-ink)"><Icon name="star" /></span>
          <span class="serif text-xl text-(--ink)">{t.reviews.allOurs}</span>
        </a>
      )
    }
  </div>
</section>
