---
/**
 * Shared template for the legal pages (privacy policy, terms, disclaimer). Copy: src/data/legal.ts.
 * Plain readable page: H1, last-updated date, contents list, one H2 per section.
 * Schema: WebPage + BreadcrumbList (no FAQ, no rating).
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import { business, breadcrumbLd, graphLd, organizationLd, webPageLd, websiteLd } from '../../data/business';
import type { LegalPage } from '../../data/legal';

interface Props {
  page: LegalPage;
}
const { page } = Astro.props;
const pageUrl = `${business.url}${page.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: page.breadcrumb, path: page.slug },
];
const updatedText = new Date(`${page.updated}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  webPageLd({ pageUrl, name: page.metaTitle, dateModified: page.updated }),
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
);
---

<SiteLayout title={page.metaTitle} description={page.metaDescription} path={page.slug} jsonLd={jsonLd} crumbs={crumbs} nap={{ eyebrow: 'Find us', h2Lead: 'Our dispatch', h2Accent: 'base', body: 'Questions about this page? Call us any time.' }}>
  <section class="relative pt-12 pb-6 md:pt-20">
    <div class="mx-auto max-w-[820px] px-4 md:px-6">
      <p class="eyebrow-warm">{page.eyebrow}</p>
      <h1 class="mt-4 text-4xl md:text-5xl">{page.h1}</h1>
      <p class="mt-4 text-sm text-(--gray-ink)">Last updated: <time datetime={page.updated}>{updatedText}</time></p>
      <p class="mt-6 text-xl text-(--ink)">{page.intro}</p>

      <nav aria-label="On this page" class="mt-10 rounded-[24px] bg-(--tint) p-6">
        <p class="font-medium text-(--ink)">On this page</p>
        <ol class="mt-3 grid gap-x-8 gap-y-1 text-lg sm:grid-cols-2">
          {
            page.sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="text-(--blue-ink) underline underline-offset-4">{s.h2}</a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <section class="relative pt-6 pb-20 md:pb-28">
    <div class="mx-auto max-w-[820px] space-y-12 px-4 md:px-6">
      {
        page.sections.map((s) => (
          <div id={s.id} class="scroll-mt-28">
            <h2 class="text-2xl md:text-3xl">{s.h2}</h2>
            {s.paras?.map((p) => <p class="mt-4 text-lg">{p}</p>)}
            {s.items && (
              <ul class="mt-4 list-disc space-y-2 pl-6 text-lg marker:text-(--blue)">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>
  </section>
</SiteLayout>
