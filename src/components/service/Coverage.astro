---
/**
 * Local SEO core for a service page: base, confirmed destination hospitals (destinations
 * only, no logos, no partner wording), Dhaka area chips and district chips. Chips link
 * only to pages that exist ("Ambulance in {Area}", "Dhaka to {District} ambulance").
 * Optional: no area chips (cov.areasH3 omitted), and a "Family abroad?" WhatsApp note.
 */
import Icon from '../Icon.astro';
import { business, getService, shown } from '../../data/business';
import { homeEn } from '../../data/home';
import { hp } from '../../data/homepage';
import { ui, type Lang } from '../../data/ui';
import { pickupAnyHospital, type Destination } from '../../data/destinations';
import type { ServicePage } from '../../data/service-pages/schema';
interface Props {
  cov: NonNullable<ServicePage['coverage']>;
  /** Client-confirmed destinations only. */
  hospitals: Destination[];
  published: Set<string>;
  areaPages: Map<string, string>;
  districtPages: Map<string, string>;
  lang?: Lang;
  placement?: string;
}
const { cov, hospitals, published, areaPages, districtPages, lang = 'en', placement = 'coverage' } = Astro.props;
const t = ui[lang];
const wa = shown(business.whatsapp);
const hints = new Map(hp.coverage.areas.map((a) => [a.name, a.hint]));
const interDistrict = getService('inter-district');
const interHref = published.has(interDistrict.path) ? interDistrict.path : '/#ambulance-inter-district';
// Hospitals block: an "any hospital" promise waits for pickupAnyHospital; a plain list needs entries.
const showHospitals = cov.anyHospitalGate ? pickupAnyHospital.verified : hospitals.length > 0;
const districtLabel = (d: string) => (cov.districtChip ? cov.districtChip.replace('{d}', t.coverage.districtName(d)) : t.coverage.districtName(d));
const chip = 'inline-flex min-h-12 items-center gap-2 rounded-full border border-(--line) bg-(--card) px-5 py-2 text-(--ink)';
---

<section class="relative py-20 md:py-28">
  <div class="mx-auto max-w-[1240px] px-4 md:px-6">
    <div class="max-w-3xl">
      <p class="eyebrow-warm">{cov.eyebrow}</p>
      <h2 class="mt-4">{cov.h2Lead} <em>{cov.h2Accent}</em></h2>
      <p class="mt-6 text-xl text-(--ink)">{cov.answer}</p>
    </div>

    {
      showHospitals && (
        <>
          <h3 class="mt-14">{cov.hospitalsH3}</h3>
          <p class="mt-3 text-lg">{cov.hospitalsLead}</p>
          {hospitals.length > 0 && (
            <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              {hospitals.map((h) => (
                <li class="flex gap-3 rounded-[22px] bg-(--card) p-4 soft-shadow">
                  <Icon name="building" class="mt-0.5 size-5 shrink-0 text-(--blue-ink)" />
                  <span>
                    <span class="block text-(--ink)">{h.name}</span>
                    <span class="block text-sm">{h.area}</span>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </>
      )
    }

    <div class="mt-14 grid gap-12 lg:grid-cols-2 [&>*]:min-w-0">
      {
        cov.areasH3 && (
          <div>
            <h3>{cov.areasH3}</h3>
            <ul class="mt-5 flex flex-wrap gap-2.5">
              {homeEn.areas.dhaka.map((name) => {
                const href = areaPages.get(name);
                return (
                  <li>
                    {href ? (
                      <a href={href} class={`${chip} font-medium no-underline hover:border-(--blue)`}>
                        {t.coverage.areaAnchor(name)}
                      </a>
                    ) : (
                      <span class={chip} title={hints.get(name)}>
                        <Icon name="pin" class="size-4 shrink-0 text-(--blue-ink)" />
                        {name}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        )
      }

      <div>
        <h3>{cov.districtsH3}</h3>
        <p class="mt-3 text-lg">{cov.districtsText}</p>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {
            homeEn.areas.districts.map((d) => {
              const href = districtPages.get(d);
              return (
                <li>
                  {href ? (
                    <a href={href} class={`${chip} font-medium no-underline hover:border-(--blue)`}>
                      {cov.districtChip ? districtLabel(d) : t.coverage.districtAnchor(d)}
                    </a>
                  ) : (
                    <span class={`${chip} border-dashed`}>
                      <Icon name="route" class="size-4 text-(--gray-ink)" />
                      {districtLabel(d)}
                    </span>
                  )}
                </li>
              );
            })
          }
        </ul>
        <p class="mt-6">
          {cov.longRoute} {t.coverage.seeLead}{' '}
          <a href={interHref} class="font-medium text-(--blue-ink) underline underline-offset-4">{cov.interDistrictAnchor}</a>{t.stop}
        </p>
      </div>

      {
        cov.abroad && (
          <div class="pebble rounded-[32px] bg-(--card) p-7 md:p-8">
            <span class="blob-a flex size-11 items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
              <Icon name="navigation" class="size-5" />
            </span>
            <h3 class="mt-4">{cov.abroad.h3}</h3>
            <p class="mt-3 text-lg">{cov.abroad.text}</p>
            {wa && (
              <a
                href={wa.url}
                class:list={[
                  'mt-6 inline-flex min-h-14 items-center justify-center gap-2.5 rounded-full bg-whatsapp px-6 text-[19px] font-bold text-white no-underline transition hover:brightness-95',
                  lang === 'bn' ? 'font-body' : 'font-heading',
                ]}
                data-placement={`${placement}-abroad`}
                rel="noopener"
              >
                <Icon name="whatsapp" />
                {t.cta.whatsapp}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
