---
/**
 * Directions of travel (inter-district hub): "From Dhaka to your district", "From your district
 * to Dhaka", "Pickup from any Dhaka hospital". Items with verified: false do not render; with
 * one item left, its text sits under the H2 without an H3 (no heading repeating the H2).
 */
import Icon from '../Icon.astro';
import { getService } from '../../data/business';
import type { ServicePage } from '../../data/service-pages/schema';
interface Props {
  dir: NonNullable<ServicePage['directions']>;
  published: Set<string>;
}
const { dir, published } = Astro.props;
const items = dir.items.filter((it) => it.verified);
const h2 = items.length < dir.items.length && dir.h2Partial ? dir.h2Partial : dir.h2;
const hrefFor = (key: Parameters<typeof getService>[0]) => {
  const s = getService(key);
  return published.has(s.path) ? s.path : `/#ambulance-${key}`;
};
const frames = ['blob-a', 'blob-b'];
---

<section class="relative py-20 md:py-28">
  <div class="mx-auto grid max-w-[1240px] gap-8 px-4 md:px-6 lg:grid-cols-12 lg:gap-14 [&>*]:min-w-0">
    <div class="lg:col-span-5">
      <p class="eyebrow-warm">{dir.eyebrow}</p>
      <h2 class="mt-4">{h2}</h2>
    </div>
    <ul class="lg:col-span-7 lg:pt-10">
      {
        items.map((it, i) => (
          <li class={`flex gap-5 ${items.length > 1 ? 'border-b border-(--line) py-7 first:pt-0 last:border-0 last:pb-0' : ''}`}>
            <span class={`${frames[i % 2]} flex size-12 shrink-0 items-center justify-center bg-(--blue-soft) text-(--blue-ink)`}>
              <Icon name={it.icon} class="size-5" />
            </span>
            <div>
              {items.length > 1 && <h3>{it.h3}</h3>}
              <p class:list={[items.length > 1 ? 'mt-2 text-lg' : 'text-xl leading-relaxed text-(--ink)']}>{it.text}</p>
              {it.link && (
                <a href={hrefFor(it.link.key)} class="mt-3 inline-flex items-center gap-2 font-medium text-(--blue-ink) underline underline-offset-4">
                  {it.link.anchor}
                  <Icon name="arrow-right" class="size-4" />
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
