---
/**
 * Use-case cards ("Trips we run"): same card style as the homepage "Why families call us".
 * A card with verified: false does not render. Links go to the service page, or its
 * homepage card until that page exists.
 */
import Icon from '../Icon.astro';
import { getService } from '../../data/business';
import type { ServicePage } from '../../data/service-pages/schema';
interface Props {
  trips: NonNullable<ServicePage['trips']>;
  published: Set<string>;
}
const { trips, published } = Astro.props;
const items = trips.items.filter((t) => t.verified);
const hrefFor = (key: Parameters<typeof getService>[0]) => {
  const s = getService(key);
  return published.has(s.path) ? s.path : `/#ambulance-${key}`;
};
const frames = ['blob-a', 'blob-b'];
// Six-column grid: rows of three; a short last row stretches so no gap is left.
const rest = items.length % 3;
const span = (i: number) => {
  if (rest === 2 && i >= items.length - 2) return 'lg:col-span-3';
  if (rest === 1 && i === items.length - 1) return 'lg:col-span-6';
  return 'lg:col-span-2';
};
---

<section class="relative overflow-hidden bg-(--tint) py-20 md:py-28">
  <svg class="absolute top-0 left-0 h-10 w-full text-(--page) md:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v34c-180 30-360 46-540 30S540 18 360 30 120 70 0 54Z"></path></svg>
  <div class="relative mx-auto max-w-[1240px] px-4 pt-6 md:px-6">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow-warm">{trips.eyebrow}</p>
        <h2 class="mt-4">{trips.h2Lead} <em>{trips.h2Accent}</em></h2>
      </div>
      <p class="text-lg lg:col-span-4 lg:col-start-9">{trips.intro}</p>
    </div>
    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
      {
        items.map((it, i) => (
          <li class={`reveal pebble flex flex-col rounded-[32px] bg-(--card) p-7 ${span(i)}`}>
            <span class={`${frames[i % 2]} flex size-14 items-center justify-center bg-(--blue-soft) text-(--blue-ink)`}>
              <Icon name={it.icon} class="size-6" />
            </span>
            <h3 class="mt-6">{it.title}</h3>
            <p class="mt-2.5 grow">{it.text}</p>
            {it.link && (it.link.key || it.link.href) && (
              <a
                href={it.link.key ? hrefFor(it.link.key) : it.link.href}
                class="mt-5 inline-flex items-center gap-2 font-medium text-(--blue-ink) underline underline-offset-4"
                data-placement={it.link.placement}
                rel={it.link.href?.startsWith('http') ? 'noopener' : undefined}
              >
                {it.link.anchor}
                <Icon name="arrow-right" class="size-4" />
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
