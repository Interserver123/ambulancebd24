---
/** Hospitals as destinations only (CLAUDE.md rule 3). Never partners. */
import Icon from '../Icon.astro';
import { hp } from '../../data/homepage';
import { warm as w } from '../../data/home-warm';
const d = hp.destinations;
const tints = ['bg-(--gray-soft)', 'bg-(--blue-soft)', 'bg-(--tint)'];
---

<section class="relative bg-(--tint) py-20 md:py-28">
  <svg class="absolute top-0 left-0 h-10 w-full text-(--page) md:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v40c-200 26-380 20-560-6S520 14 340 38 110 64 0 40Z"></path></svg>
  <div class="relative mx-auto grid max-w-[1240px] gap-12 px-4 pt-6 md:px-6 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <p class="eyebrow-warm">{w.destinations.eyebrow}</p>
      <h2 class="mt-4">{w.destinations.h2Lead} <em>{w.destinations.h2Accent}</em></h2>
      <p class="mt-5 text-lg">{d.body}</p>
    </div>
    <div class="lg:col-span-7 lg:col-start-6">
      <ul class="grid gap-4 sm:grid-cols-2">
        {
          d.hospitals.map((h, i) => (
            <li class={`reveal pebble flex gap-4 rounded-[28px] bg-(--card) p-5 ${i % 2 ? 'sm:translate-y-6' : ''}`}>
              <span class={`blob-${i % 2 ? 'b' : 'a'} flex size-12 shrink-0 items-center justify-center ${tints[i % tints.length]} text-(--ink)`}><Icon name="building" /></span>
              <span>
                <span class="serif block text-lg text-(--ink)">{h.name}</span>
                <span class="block text-sm">{h.area}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-sm text-(--gray-ink) italic">{d.note}</p>
    </div>
  </div>
</section>
