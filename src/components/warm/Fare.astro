---
import Icon from '../Icon.astro';
import PhotoSlot from '../PhotoSlot.astro';
import CallButton from './CallButton.astro';
import { business, copy, shown, services } from '../../data/business';
import { homeEn as t } from '../../data/home';
import { warm as w } from '../../data/home-warm';
const wa = shown(business.whatsapp);
const fares = shown(business.pending.fareRanges) ?? [];
const checklist = [...t.fare.checklist, ...(business.claims.fareInWritingSopLive ? [t.fare.inWriting] : [])];
const money = (n?: number) => (n == null ? '—' : `৳${n.toLocaleString('en-US')}`);
const serviceName = (key: string) => services.find((s) => s.key === key)?.en ?? key;
---

<section class="relative bg-(--tint) pb-24 md:pb-32">
  <div class="relative mx-auto max-w-[1240px] px-4 md:px-6">
    <div class="relative overflow-hidden rounded-[48px] bg-(--ink) px-6 py-14 text-white/85 md:rounded-[72px] md:px-14 md:py-20">
      <div class="drift blob-b pointer-events-none absolute -right-20 -bottom-24 size-[380px] bg-(--blue) opacity-25 blur-3xl"></div>
      <div class="relative grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="eyebrow-warm text-(--gray)!">{w.fare.eyebrow}</p>
          <h2 class="mt-4 text-white!">{w.fare.h2Lead} <em class="text-(--blue-soft)!">{w.fare.h2Accent}</em></h2>
          <p class="mt-6 max-w-2xl text-lg">{t.fare.body}</p>
          <ul class="mt-9 space-y-4">
            {
              checklist.map((item) => (
                <li class="flex items-center gap-4 text-lg text-white">
                  <span class="blob-a flex size-10 shrink-0 items-center justify-center bg-(--gray-soft) text-(--gray-ink)">
                    <Icon name="check" class="size-5" />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <CallButton placement="fare-promise" />
            {
              wa && (
                <a href={wa.url} class="inline-flex min-h-12 items-center gap-2 rounded-full border-2 border-whatsapp bg-white px-6 font-heading text-[19px] font-bold text-whatsapp no-underline" data-placement="fare-promise" rel="noopener">
                  <Icon name="whatsapp" />
                  {copy.cta.whatsapp.en}
                </a>
              )
            }
          </div>
        </div>
        <div class="lg:col-span-5 lg:self-stretch">
          <div class="blob-d aspect-[4/3] h-full overflow-hidden ring-1 ring-white/10 lg:aspect-auto lg:min-h-[360px]">
            <PhotoSlot slot="fare" sizes="(min-width: 1024px) 420px, 100vw" />
          </div>
        </div>

        {
          fares.length > 0 && (
            <div class="overflow-x-auto rounded-[32px] bg-(--card) p-6 text-(--ink) lg:col-span-12">
              <table class="w-full min-w-[560px] text-left">
                <caption class="serif mb-4 text-left text-xl">{t.fare.table.caption}</caption>
                <thead>
                  <tr class="border-b border-(--line)">
                    <th class="py-3 pr-4">{t.fare.table.type}</th>
                    <th class="py-3 pr-4">{t.fare.table.range}</th>
                    <th class="py-3 pr-4">{t.fare.table.waiting}</th>
                    <th class="py-3">{t.fare.table.extraStop}</th>
                  </tr>
                </thead>
                <tbody>
                  {fares.map((r) => (
                    <tr class="border-b border-(--line)">
                      <td class="py-3 pr-4">{serviceName(r.serviceKey)}</td>
                      <td class="py-3 pr-4">
                        {money(r.min)}–{money(r.max)}
                      </td>
                      <td class="py-3 pr-4">{money(r.waitingPerHour)}</td>
                      <td class="py-3">{money(r.extraStop)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
