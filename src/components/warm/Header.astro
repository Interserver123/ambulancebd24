---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { brandLogo } from '../../lib/photos';
import { business, getService, services } from '../../data/business';
import type { HomeNav } from '../home/types';
import { ui, type Lang } from '../../data/ui';
interface Props {
  nav: HomeNav;
  lang?: Lang;
}
const { nav, lang = 'en' } = Astro.props;
const t = ui[lang];
const n = t.header.nav;
const published = new Set(nav.services.map((s) => s.path));

// Services dropdown: every published service page, in catalogue order.
const serviceLinks = services
  .filter((s) => published.has(s.path))
  .map((s) => ({ label: lang === 'bn' ? s.bn : s.en, path: s.path }));

// Locations dropdown: Inside Dhaka (the Dhaka areas hub) and Inter-District.
const inter = getService('inter-district');
const locationLinks = [
  { label: n.insideDhaka, hint: n.insideDhakaHint, path: '/ambulance-service-areas-dhaka/' },
  ...(published.has(inter.path) ? [{ label: n.interDistrict, hint: n.interDistrictHint, path: inter.path }] : []),
];

type Item = { label: string; path: string } | { label: string; menu: { label: string; hint?: string; path: string }[]; path?: string };
// About and Blog appear only once their pages exist. Contact falls back to the footer contact block (never "#").
const items: Item[] = [
  { label: n.home, path: '/' },
  ...(serviceLinks.length ? [{ label: n.services, path: '/services/', menu: [...serviceLinks, { label: n.allServices, path: '/services/' }] }] : []),
  ...(nav.about ? [{ label: n.about, path: nav.about }] : []),
  ...(locationLinks.length ? [{ label: n.locations, menu: locationLinks }] : []),
  ...(nav.blog ? [{ label: n.blog, path: nav.blog }] : []),
  { label: t.header.links.contact, path: nav.contact ?? '#contact' },
];
// With About and Blog live the bar is wider, so the hours text waits for xl screens.
const linkCls = 'font-medium text-(--ink) hover:text-(--blue-ink)';
---

<header class="sticky top-0 z-50 px-3 pt-3 md:px-6 md:pt-4">
  <div class="mx-auto flex h-16 max-w-[1240px] items-center justify-between gap-3 rounded-full border border-(--line) bg-(--card)/85 pr-2 pl-3 sm:pl-5 shadow-[0_10px_30px_-18px_rgb(28_40_110/0.35)] backdrop-blur-md md:h-[72px] md:pl-7">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label={t.header.homeLabel}>
{
        brandLogo ? (
          <Image src={brandLogo} alt={business.name} height={96} class="h-11 w-auto md:h-14" loading="eager" fetchpriority="high" />
        ) : (
          <>
            <span class="blob-a flex size-10 items-center justify-center bg-(--blue-soft) text-(--blue-ink)"><Icon name="ambulance" class="size-6" /></span>
            <span class="serif text-lg whitespace-nowrap text-(--ink) sm:text-xl md:text-[1.4rem]">{business.name}</span>
          </>
        )
      }
    </a>
    <nav aria-label="Main" class="hidden items-center gap-5 whitespace-nowrap lg:flex xl:gap-7">
      {
        items.map((it) =>
          'menu' in it ? (
            <div class="group relative">
              {it.path ? (
                <a href={it.path} class={`${linkCls} inline-flex items-center gap-1`} aria-haspopup="true">
                  {it.label}
                  <Icon name="chevron-down" class="size-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180" />
                </a>
              ) : (
                <button type="button" class={`${linkCls} inline-flex cursor-default items-center gap-1`} aria-haspopup="true">
                  {it.label}
                  <Icon name="chevron-down" class="size-4 transition-transform group-focus-within:rotate-180 group-hover:rotate-180" />
                </button>
              )}
              <div class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-4 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="min-w-64 rounded-[24px] border border-(--line) bg-(--card) p-2 shadow-[0_20px_40px_-20px_rgb(28_40_110/0.45)]">
                  {it.menu.map((m) => (
                    <li>
                      <a href={m.path} class="block rounded-2xl px-4 py-2.5 text-(--ink) no-underline hover:bg-(--tint) hover:text-(--blue-ink) focus:bg-(--tint)">
                        <span class="block font-medium">{m.label}</span>
                        {m.hint && <span class="block text-sm text-(--gray-ink)">{m.hint}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a href={it.path} class={linkCls}>
              {it.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="flex items-center gap-4">
      <span class:list={['hidden items-center gap-2 text-sm text-(--gray-ink)', items.length > 4 ? 'xl:flex' : 'lg:flex']}>
        <span class="relative flex size-2.5"><span class="absolute inset-0 animate-ping rounded-full bg-(--gray) opacity-60 motion-reduce:hidden"></span><span class="relative size-2.5 rounded-full bg-(--gray-ink)"></span></span>
        {t.hoursShort}
      </span>
      <a href={business.phone.tel} class="cta-call group inline-flex min-h-12 shrink-0 items-center gap-2 rounded-full bg-call px-4 whitespace-nowrap text-white no-underline sm:px-5" data-placement="header">
        <Icon name="phone" class="ringing size-5" />
        <span class:list={['phone hidden font-bold sm:inline', lang === 'bn' ? 'font-body' : 'font-heading']}>{t.header.call}</span>
        <span class:list={['font-bold sm:hidden', lang === 'bn' ? 'font-body' : 'font-heading']}>{t.header.callShort}</span>
      </a>
      <button type="button" class="menu-btn inline-flex size-12 shrink-0 items-center justify-center rounded-full border border-(--line) bg-(--card) text-(--ink) lg:hidden" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.header.menu} data-menu-btn>
        <span data-open-icon><Icon name="menu" class="size-6" /></span>
        <span class="hidden" data-close-icon><Icon name="close" class="size-6" /></span>
      </button>
    </div>
  </div>
  <!-- Mobile and tablet menu: real links in the HTML, opened by the button above -->
  <nav id="mobile-menu" aria-label={t.header.menuLabel} class="absolute inset-x-3 top-full z-50 mt-2 hidden max-h-[calc(100dvh-12rem)] overscroll-contain overflow-y-auto rounded-[28px] border border-(--line) bg-(--card) p-3 shadow-[0_20px_40px_-20px_rgb(28_40_110/0.45)] md:inset-x-6 lg:hidden" data-menu>
    <ul class="grid gap-1">
      {
        items.map((it) =>
          'menu' in it ? (
            <li>
              {it.path ? (
                <a href={it.path} class="flex min-h-12 items-center rounded-2xl px-4 font-medium text-(--ink) no-underline active:bg-(--tint)">{it.label}</a>
              ) : (
                <p class="flex min-h-12 items-center px-4 font-medium text-(--ink)">{it.label}</p>
              )}
              <ul class="mb-1 ml-4 grid gap-0.5 border-l border-(--line) pl-2">
                {it.menu.map((m) => (
                  <li>
                    <a href={m.path} class="flex min-h-12 flex-col justify-center rounded-2xl px-4 py-1 text-(--ink) no-underline active:bg-(--tint)">
                      <span>{m.label}</span>
                      {m.hint && <span class="text-sm text-(--gray-ink)">{m.hint}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={it.path} class="flex min-h-12 items-center rounded-2xl px-4 font-medium text-(--ink) no-underline active:bg-(--tint)">{it.label}</a>
            </li>
          ),
        )
      }
    </ul>
  </nav>
</header>

<script>
  // Mobile menu: open/close with the button, Escape, a tap outside, or after choosing a link.
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const set = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('[data-open-icon]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-close-icon]')?.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(menu.classList.contains('hidden')));
    menu.addEventListener('click', (e) => (e.target as Element).closest('a') && set(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    document.addEventListener('click', (e) => !menu.contains(e.target as Node) && !btn.contains(e.target as Node) && set(false));
  }
</script>
