---
/** Four steps on a winding thread, next to a photo in an organic frame. */
import PhotoSlot from '../PhotoSlot.astro';
import CallButton from './CallButton.astro';
import { hp } from '../../data/homepage';
import { warm as w } from '../../data/home-warm';
import type { PhotoSlotKey } from '../../lib/photos';
interface Step {
  n: string;
  label: string;
  title: string;
  text: string;
}
interface Props {
  eyebrow?: string;
  h2Lead?: string;
  h2Accent?: string;
  intro?: string;
  steps?: readonly Step[];
  photo?: PhotoSlotKey;
  placement?: string;
  /** Optional practical list under the steps (service pages). */
  ready?: { h3: string; items: readonly string[] };
  /** Call button label and style (Freezer Van: quiet label, no motion; Bangla pages: Bangla label). */
  callLabel?: string;
  callLang?: string;
  calm?: boolean;
}
const {
  eyebrow = w.how.eyebrow,
  h2Lead = w.how.h2Lead,
  h2Accent = w.how.h2Accent,
  intro,
  steps = hp.timeline.steps,
  photo = 'dispatch',
  placement = 'how',
  ready,
  callLabel,
  callLang,
  calm = false,
} = Astro.props;
---

<section id="how" class="relative scroll-mt-28 overflow-hidden bg-(--tint) py-20 md:py-28">
  <svg class="absolute top-0 left-0 h-10 w-full text-(--page) md:h-16" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v34c-180 30-360 46-540 30S540 18 360 30 120 70 0 54Z"></path></svg>

  <div class="relative mx-auto grid max-w-[1240px] items-center gap-14 px-4 pt-6 md:px-6 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5 lg:flex lg:flex-col lg:self-stretch">
      <div class="blob-a relative mx-auto aspect-square w-[86%] overflow-hidden soft-shadow lg:aspect-auto lg:min-h-[360px] lg:w-full lg:flex-1 lg:rounded-[48px]!">
        <PhotoSlot slot={photo} sizes="(min-width: 1024px) 440px, 86vw" widths={[480, 800, 1000]} />
      </div>
      <div class="mt-10 flex justify-center"><CallButton placement={placement} label={callLabel} lang={callLang} calm={calm} /></div>
    </div>

    <div class="lg:col-span-6 lg:col-start-7">
      <p class="eyebrow-warm">{eyebrow}</p>
      <h2 class="mt-4">{h2Lead} <em>{h2Accent}</em></h2>
      {intro && <p class="mt-5 max-w-xl text-lg">{intro}</p>}

      <ol class="relative mt-12 space-y-9">
        <svg class="absolute top-6 left-[27px] h-[calc(100%-3rem)] w-6 text-(--blue)" viewBox="0 0 24 300" preserveAspectRatio="none" aria-hidden="true">
          <path d="M12 0C2 50 22 100 12 150S2 250 12 300" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="4 8" stroke-linecap="round" opacity=".55"></path>
        </svg>
        {
          steps.map((s) => (
            <li class="reveal relative flex gap-6">
              <span class="serif relative z-10 flex size-14 shrink-0 items-center justify-center rounded-full bg-(--card) text-xl text-(--blue-ink) soft-shadow">{s.n}</span>
              <div class="pt-1">
                <p class="text-sm text-(--gray-ink) italic">{s.label}</p>
                <h3 class="mt-0.5">{s.title}</h3>
                <p class="mt-2 max-w-md text-lg">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      {
        ready && (
          <div class="pebble mt-12 rounded-[32px] bg-(--card) p-7 md:p-8">
            <h3>{ready.h3}</h3>
            <ul class="mt-5 space-y-3">
              {ready.items.map((it) => (
                <li class="flex gap-3 text-lg text-(--ink)">
                  <span class="mt-2.5 size-2 shrink-0 rounded-full bg-(--blue)" aria-hidden="true" />
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>
