---
/** Organic photo cards. Only confirmed services render. "Details" appears once the service page exists. */
import Icon from '../Icon.astro';
import PhotoSlot from '../PhotoSlot.astro';
import { business, getService } from '../../data/business';
import { hp } from '../../data/homepage';
import { warm as w } from '../../data/home-warm';
import type { PhotoSlotKey } from '../../lib/photos';
interface Props {
  published: Set<string>;
}
const { published } = Astro.props;
const cards = hp.ambulances.cards
  .map((c) => ({ ...c, service: getService(c.key) }))
  .filter((c) => c.service.status === 'fact')
  // Button to the service page. Live only once the page exists (no broken links);
  // dev shows every button so the design can be reviewed.
  .map((c) => ({ ...c, details: published.has(c.service.path) || import.meta.env.DEV ? c.service.path : undefined }));
// Alternating frames and offsets give an organic, non-grid rhythm.
const frames = ['blob-c', 'blob-d', 'rounded-[40px]', 'blob-d', 'blob-c', 'rounded-[40px]', 'blob-c'];
const shift = ['', 'lg:mt-16', 'lg:mt-6', 'lg:-mt-10', 'lg:mt-6', 'lg:-mt-4', ''];
const sizes = '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw';
---

<section id="ambulances" class="relative scroll-mt-28 py-20 md:py-28">
  <div class="mx-auto max-w-[1240px] px-4 md:px-6">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow-warm">{w.services.eyebrow}</p>
        <h2 class="mt-4">{w.services.h2Lead} <em>{w.services.h2Accent}</em></h2>
      </div>
      <p class="text-lg lg:col-span-4 lg:col-start-9">{hp.ambulances.intro}</p>
    </div>

    <ul class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-10">
      {
        cards.map((c, i) => (
          <li id={`ambulance-${c.key}`} class={`reveal group scroll-mt-32 ${shift[i % shift.length]}`}>
            <div class={`${frames[i % frames.length]} relative aspect-[4/3] overflow-hidden soft-shadow`}>
              <PhotoSlot slot={c.key as PhotoSlotKey} sizes={sizes} eager={i < 2} class="transition-transform duration-700 group-hover:scale-105 motion-reduce:transform-none" />
            </div>
            <div class="px-2 pt-6">
              <h3>{c.title}</h3>
              <p class="mt-2.5">{c.text}</p>
              {c.trips && (
                <ul class="mt-4 grid gap-1.5" aria-label={`${hp.ambulances.tripsLabel}: ${c.title}`}>
                  {c.trips.map((tr) => (
                    <li class="flex items-start gap-2.5 text-[15px] text-(--ink)">
                      <span class="mt-1 flex size-4 shrink-0 items-center justify-center rounded-full bg-(--blue-soft) text-(--blue-ink)"><Icon name="check" class="size-3" /></span>
                      {tr}
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
                {c.details && (
                  <a href={c.details} class="group/btn inline-flex min-h-12 items-center gap-2 rounded-full bg-(--ink) py-2 pr-2 pl-5 font-medium text-white no-underline transition hover:bg-(--blue-ink)">
                    {hp.ambulances.details(c.title)}
                    <span class="flex size-8 items-center justify-center rounded-full bg-white/15"><Icon name="arrow-right" class="size-4 transition-transform group-hover/btn:translate-x-0.5" /></span>
                  </a>
                )}
                <a href={business.phone.tel} class="inline-flex items-center gap-2 font-medium text-(--ink) underline decoration-(--blue)/50 underline-offset-4 hover:text-call" data-placement={`card-${c.key}`}>
                  <Icon name="phone" class="size-4" />
                  {hp.ambulances.callFor}
                </a>
              </div>
            </div>
          </li>
        ))
      }
      <li class="reveal lg:-mt-6">
        <a href={business.phone.tel} class="pebble group flex h-full min-h-80 flex-col justify-between rounded-[40px] bg-(--blue-soft) p-8 no-underline" data-placement="service-help">
          <span>
            <span class="serif block text-3xl text-(--ink)">{w.services.helpTitle}</span>
            <span class="mt-3 block text-(--ink)/80">{w.services.helpText}</span>
          </span>
          <span class="mt-8 flex items-center gap-3">
            <span class="flex size-12 items-center justify-center rounded-full bg-call text-white"><Icon name="phone" class="ringing size-5" /></span>
            <span class="phone serif text-2xl text-(--ink)">{business.phone.display}</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
