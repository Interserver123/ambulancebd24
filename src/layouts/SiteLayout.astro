---
/**
 * Shared page layout (warm design, deck v1.3). Every page gets: header, breadcrumbs
 * (non-home pages), the reviews block, NAP + map, footer and the mobile call bar.
 *
 * Page order: <default slot> · ReviewsBlock · <slot "after-reviews"> · NapMap · <slot "end">
 */
import BaseLayout from './BaseLayout.astro';
import '../styles/warm.css';
import hind400 from '@fontsource/hind-siliguri/files/hind-siliguri-latin-400-normal.woff2?url';
import hind400bn from '@fontsource/hind-siliguri/files/hind-siliguri-bengali-400-normal.woff2?url';
import Header from '../components/warm/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/home/MobileCallBar.astro';
import Breadcrumbs, { type Crumb } from '../components/global/Breadcrumbs.astro';
import ReviewsBlock from '../components/global/ReviewsBlock.astro';
import NapMap from '../components/global/NapMap.astro';
import type { Lang } from '../data/ui';
import { homeData } from '../lib/homeNav';

interface Heading {
  eyebrow: string;
  h2Lead: string;
  h2Accent: string;
}
interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>;
  /** Utility pages (404): noindex, no canonical. */
  noindex?: boolean;
  alternates?: { hreflang: string; path: string }[];
  /** Non-home pages: Home first, current page last. */
  crumbs?: Crumb[];
  /** Omit to leave the block out (e.g. the 404 page). */
  reviews?: Heading & { tags?: string[] };
  /** "svc" on service pages: fixed heading scale (warm.css). */
  mainClass?: string;
  nap?: Heading & { body: string; calm?: boolean };
  /** Page language: sets <html lang>, hreflang/og:locale and the chrome strings (src/data/ui.ts). */
  lang?: Lang;
  /** hreflang="x-default" target (English homepage by default). */
  xDefault?: string;
}
const { title, description, path, jsonLd, noindex = false, alternates = [], crumbs, reviews, nap, mainClass, lang = 'en', xDefault } = Astro.props;
const { nav } = await homeData();
---

<BaseLayout title={title} description={description} path={path} lang={lang} jsonLd={jsonLd} alternates={alternates} xDefault={xDefault} noindex={noindex} preloads={lang === 'bn' ? [hind400bn, hind400] : [hind400]}>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="warm" id="top">
    <Header nav={nav} lang={lang} />
    {crumbs && <Breadcrumbs items={crumbs} />}
    <main class={mainClass}>
      <slot />
      {reviews && <ReviewsBlock {...reviews} lang={lang} />}
      <slot name="after-reviews" />
      {nap && <NapMap {...nap} lang={lang} />}
      <slot name="end" />
    </main>
    <Footer lang={lang} />
    <MobileCallBar lang={lang} />
  </div>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const whenNear = (el: Element, margin: string, run: () => void) => {
    if (!('IntersectionObserver' in window)) return run();
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          run();
        }
      },
      { rootMargin: margin },
    );
    io.observe(el);
  };

  // Fade sections in on large screens (CSS limits it); content shows without JS.
  const items = document.querySelectorAll('.reveal');
  if (reduce || !('IntersectionObserver' in window)) {
    items.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
      { rootMargin: '0px 0px -10% 0px' },
    );
    items.forEach((el, i) => {
      (el as HTMLElement).style.transitionDelay = `${(i % 4) * 80}ms`;
      io.observe(el);
    });
    // Failsafe: never leave content hidden if the observer doesn't fire.
    setTimeout(() => items.forEach((el) => el.classList.add('is-in')), 2500);
  }

  // Call buttons lean gently toward the pointer (mouse only).
  if (!reduce && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        el.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.12}px, ${(e.clientY - r.top - r.height / 2) * 0.2}px)`;
      });
      el.addEventListener('pointerleave', () => (el.style.transform = ''));
    });
  }

  // Copy the hotline number.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const label = btn.querySelector('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        if (label) {
          const before = label.textContent;
          label.textContent = btn.dataset.copied ?? '';
          setTimeout(() => (label.textContent = before), 1800);
        }
      } catch {
        /* clipboard blocked: the number is still visible and tappable */
      }
    });
  });

  // Share the hotline with family: native share sheet on phones, copy elsewhere.
  document.querySelectorAll<HTMLButtonElement>('[data-share-text]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.shareText ?? '';
      const url = btn.dataset.shareUrl ?? '';
      try {
        if (navigator.share) return void (await navigator.share({ text, url }));
        await navigator.clipboard.writeText(`${text} ${url}`);
        const label = btn.querySelector('[data-share-label]');
        if (label) {
          const before = label.textContent;
          label.textContent = btn.dataset.shared ?? '';
          setTimeout(() => (label.textContent = before), 2000);
        }
      } catch {
        /* share sheet closed or clipboard blocked */
      }
    });
  });

  // Google map loads only when the visitor asks for it.
  document.querySelectorAll<HTMLElement>('[data-click-map]').forEach((box) => {
    box.querySelector('[data-load-map]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.clickMap ?? '';
      iframe.title = 'Map: Ambulance BD 24, Mohakhali, Dhaka';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      box.querySelector('[data-map-placeholder]')?.remove();
      box.appendChild(iframe);
    });
  });

  // Google reviews widget (third-party): script loads only when the section is near.
  document.querySelectorAll<HTMLElement>('[data-lazy-widget]').forEach((box) =>
    whenNear(box, '600px 0px', () => {
      box.innerHTML = box.dataset.widgetMount ?? '';
      const s = document.createElement('script');
      s.src = box.dataset.lazyWidget ?? '';
      s.async = true;
      box.appendChild(s);
    }),
  );

  // Call-back forms: post to the Pages Function, show the result in place.
  let turnstileLoading = false;
  document.querySelectorAll<HTMLFormElement>('[data-callback-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const successText = form.querySelector('[data-success-text]')?.textContent ?? '';
    const siteKey = form.dataset.turnstile;
    // Turnstile (spam check) loads only once someone starts filling the form.
    if (siteKey) {
      form.addEventListener(
        'focusin',
        () => {
          const box = form.querySelector<HTMLElement>('[data-turnstile-box]');
          if (!box) return;
          box.classList.add('cf-turnstile');
          box.dataset.sitekey = siteKey;
          if (turnstileLoading) return void (window as unknown as { turnstile?: { render: (el: HTMLElement) => void } }).turnstile?.render(box);
          turnstileLoading = true;
          const s = document.createElement('script');
          s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          s.async = true;
          document.head.appendChild(s);
        },
        { once: true },
      );
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;
      const button = form.querySelector('button[type="submit"]');
      button?.setAttribute('disabled', '');
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = successText;
        (window as unknown as { zaraz?: { track: (n: string, d: object) => void } }).zaraz?.track('form_submit', { page: location.pathname });
      } catch {
        status.textContent = form.dataset.error ?? '';
      } finally {
        status.classList.remove('hidden');
        button?.removeAttribute('disabled');
      }
    });
  });
</script>
