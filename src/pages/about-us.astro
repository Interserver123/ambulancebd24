---
/**
 * /about-us/ (old WordPress URL, kept). Copy: src/data/about.ts.
 * Order: hero · at-a-glance facts + photo · what we do · how a call works · promises · where we
 * are (links to area pages) · vehicle photos · official profiles · reviews · FAQ · NAP + map · call.
 * Written for people and for AI answer engines: plain facts, one H1, visible FAQ = FAQPage schema.
 * Schema: AboutPage (mainEntity = the EmergencyService node) + BreadcrumbList + FAQPage.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import How from '../components/warm/How.astro';
import Faq from '../components/warm/Faq.astro';
import Final from '../components/warm/Final.astro';
import { about as d } from '../data/about';
import { hp } from '../data/homepage';
import { business, breadcrumbLd, faqPageLd, graphLd, ids, organizationLd, webPageLd, websiteLd } from '../data/business';
import { publishedPaths } from '../lib/routes';

const pub = await publishedPaths('en');
const pageUrl = `${business.url}${d.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.breadcrumb, path: d.slug },
];
const areaLinks = ['Mohakhali', 'Gulshan', 'Mirpur', 'Uttara'].map((name) => ({ name, href: pub.areas.get(name) })).filter((a) => a.href);

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  { ...webPageLd({ pageUrl, name: d.metaTitle, dateModified: d.updated, type: 'AboutPage' }), mainEntity: { '@id': ids.business } },
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
  faqPageLd(d.faq.items, pageUrl),
);
---

<SiteLayout
  title={d.metaTitle}
  description={d.metaDescription}
  path={d.slug}
  jsonLd={jsonLd}
  crumbs={crumbs}
  mainClass="svc"
  reviews={{ eyebrow: 'Reviews', h2Lead: 'What families', h2Accent: 'say' }}
  nap={d.nap}
>
  <ServiceHero hero={d.hero} crewVerified={false} placement="about-hero" />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto grid max-w-[1240px] gap-10 px-4 md:px-6 lg:grid-cols-12 lg:items-start">
      <div class="lg:col-span-7">
        <p class="eyebrow-warm">{d.facts.eyebrow}</p>
        <h2 class="mt-4">{d.facts.h2Lead} <em>{d.facts.h2Accent}</em></h2>
        <p class="mt-4 text-lg">{d.facts.intro}</p>
        <dl class="mt-8 divide-y divide-(--line) rounded-[32px] bg-(--card) p-6 soft-shadow md:p-8">
          {
            d.facts.rows.map((r) => (
              <div class="grid gap-1 py-3.5 sm:grid-cols-[12rem_1fr] sm:gap-6">
                <dt class="text-sm text-(--gray-ink) italic">{r.k}</dt>
                <dd class="text-(--ink)">{'href' in r && r.href ? <a href={r.href} class="phone text-(--blue-ink) underline underline-offset-4">{r.v}</a> : r.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <figure class="lg:col-span-5">
        <div class="blob-c aspect-[4/3] overflow-hidden bg-(--tint) soft-shadow">
          <PhotoSlot slot="dispatch" sizes="(min-width: 1024px) 40vw, 100vw" />
        </div>
        <figcaption class="mt-3 text-sm italic">{business.name} ambulances at our base in {business.address.locality}.</figcaption>
      </figure>
    </div>
  </section>

  <section class="relative pb-20 md:pb-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.what.eyebrow}</p>
        <h2 class="mt-4">{d.what.h2Lead} <em>{d.what.h2Accent}</em></h2>
        <p class="mt-4 text-lg">{d.what.intro}</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          d.what.items.map((s) => (
            <li>
              {pub.all.has(s.href) ? (
                <a href={s.href} class="pebble flex h-full flex-col gap-2 rounded-[24px] bg-(--card) p-6 no-underline">
                  <span class="serif text-xl text-(--ink)">{s.title}</span>
                  <span class="grow text-[15px]">{s.text}</span>
                  <span class="inline-flex items-center gap-1.5 font-medium text-(--blue-ink)">
                    {s.title}
                    <Icon name="arrow-right" class="size-4" />
                  </span>
                </a>
              ) : (
                <div class="flex h-full flex-col gap-2 rounded-[24px] bg-(--card) p-6 soft-shadow">
                  <span class="serif text-xl text-(--ink)">{s.title}</span>
                  <span class="text-[15px]">{s.text}</span>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <How eyebrow={d.how.eyebrow} h2Lead={d.how.h2Lead} h2Accent={d.how.h2Accent} intro={d.how.intro} steps={hp.timeline.steps} placement="about-steps" />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.promise.eyebrow}</p>
        <h2 class="mt-4">{d.promise.h2Lead} <em>{d.promise.h2Accent}</em></h2>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          d.promise.items.map((p) => (
            <li class="rounded-[28px] bg-(--card) p-7 soft-shadow">
              <h3 class="text-2xl!">{p.title}</h3>
              <p class="mt-3 text-lg">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative pb-20 md:pb-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.where.eyebrow}</p>
        <h2 class="mt-4">{d.where.h2Lead} <em>{d.where.h2Accent}</em></h2>
        <p class="mt-4 text-lg">{d.where.intro}</p>
      </div>
      <ul class="mt-8 flex flex-wrap gap-3">
        {
          areaLinks.map((a) => (
            <li>
              <a href={a.href} title={`Ambulance in ${a.name}`} class="pebble inline-flex min-h-12 items-center gap-2 rounded-full bg-(--card) px-5 font-medium text-(--ink) no-underline">
                <Icon name="pin" class="size-4 text-(--blue-ink)" />Ambulance in {a.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-lg">
        <a href="/ambulance-service-areas-dhaka/" class="font-medium text-(--blue-ink) underline underline-offset-4">{d.where.hubAnchor}</a> ·
        <a href="/inter-district-ambulance-service/" class="font-medium text-(--blue-ink) underline underline-offset-4">{d.where.districtAnchor}</a> ·
        <a href="/locations/" class="font-medium text-(--blue-ink) underline underline-offset-4">{d.where.allAnchor}</a>
      </p>
    </div>
  </section>

  <section class="relative pb-20 md:pb-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.photos.eyebrow}</p>
        <h2 class="mt-4">{d.photos.h2Lead} <em>{d.photos.h2Accent}</em></h2>
        <p class="mt-4 text-lg">{d.photos.intro}</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-3">
        {
          (['emergency', 'icu', 'ac'] as const).map((slot) => (
            <li class="aspect-[4/3] overflow-hidden rounded-[28px] bg-(--tint) soft-shadow">
              <PhotoSlot slot={slot} sizes="(min-width: 640px) 33vw, 100vw" widths={[480, 800]} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Fragment slot="after-reviews">
    <section class="relative pb-20 md:pb-28">
      <div class="mx-auto max-w-[1240px] px-4 md:px-6">
        <div class="max-w-3xl">
          <p class="eyebrow-warm">{d.profiles.eyebrow}</p>
          <h2 class="mt-4">{d.profiles.h2}</h2>
          <p class="mt-4 text-lg">{d.profiles.intro}</p>
        </div>
        <ul class="mt-8 flex flex-wrap gap-3">
          {
            d.profiles.items.map((p) => (
              <li>
                <a href={p.href} rel="noopener" class="pebble inline-flex min-h-12 items-center gap-2 rounded-full bg-(--card) px-5 font-medium text-(--blue-ink) no-underline">
                  {p.label}<Icon name="external" class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <Faq items={d.faq.items} eyebrow={d.faq.eyebrow} h2Lead={d.faq.h2Lead} h2Accent={d.faq.h2Accent} updated={d.updated} byline={d.byline} />
  </Fragment>

  <Final slot="end" h2Lead={d.final.h2Lead} h2Accent={d.final.h2Accent} text={d.final.text} placement="about-final" />
</SiteLayout>
