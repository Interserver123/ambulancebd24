---
/**
 * Inside Dhaka hub (/ambulance-service-areas-dhaka/). Copy and areas: src/data/inside-dhaka.ts.
 * Order: hero · areas grid (links down to area pages once published) · how a call works ·
 * which ambulance (service links) · reviews · outside Dhaka · FAQ · NAP + map · final CTA.
 * Schema: EmergencyService (location page) + WebPage + BreadcrumbList + FAQPage from the same faqs[].
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import Related from '../components/service/Related.astro';
import How from '../components/warm/How.astro';
import Faq from '../components/warm/Faq.astro';
import Final from '../components/warm/Final.astro';
import { dhakaAreas, insideDhaka as d } from '../data/inside-dhaka';
import { hp } from '../data/homepage';
import { business, breadcrumbLd, emergencyServiceLd, faqPageLd, getService, graphLd, organizationLd, webPageLd, websiteLd } from '../data/business';
import { publishedPaths } from '../lib/routes';

const pub = await publishedPaths('en');
const pageUrl = `${business.url}${d.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.breadcrumb, path: d.slug },
];
const faqs = d.faq.items;
const inter = getService('inter-district');
const interHref = pub.all.has(inter.path) ? inter.path : '/#ambulance-inter-district';

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  emergencyServiceLd(),
  webPageLd({ pageUrl, name: d.metaTitle, dateModified: d.updated, type: 'CollectionPage' }),
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
  faqPageLd(faqs, pageUrl),
);
---

<SiteLayout
  title={d.metaTitle}
  description={d.metaDescription}
  path={d.slug}
  jsonLd={jsonLd}
  crumbs={crumbs}
  mainClass="svc"
  reviews={{ eyebrow: 'Reviews', h2Lead: 'What families', h2Accent: 'say' }}
  nap={d.nap}
>
  <ServiceHero hero={d.hero} crewVerified={false} placement="dhaka-hero" />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.areas.eyebrow}</p>
        <h2 class="mt-4">{d.areas.h2Lead} <em>{d.areas.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.areas.intro}</p>
      </div>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          dhakaAreas.map((a) => {
            const href = pub.areas.get(a.name);
            const isBase = a.name === business.address.locality;
            const body = (
              <>
                <span class="blob-a flex size-11 shrink-0 items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
                  <Icon name={isBase ? 'ambulance' : 'pin'} class="size-5" />
                </span>
                <span class="grow">
                  <span class="serif block text-xl text-(--ink)">{a.name}</span>
                  {(isBase || a.hint) && <span class="block text-[15px]">{isBase ? d.areas.base : a.hint}</span>}
                </span>
                {href && <Icon name="arrow-right" class="size-5 shrink-0 text-(--blue-ink)" />}
              </>
            );
            return (
              <li>
                {href ? (
                  <a href={href} title={d.areas.pageAnchor(a.name)} class="pebble flex h-full items-center gap-4 rounded-[24px] bg-(--card) p-5 no-underline">
                    {body}
                  </a>
                ) : (
                  <div class="flex h-full items-center gap-4 rounded-[24px] bg-(--card) p-5 soft-shadow">{body}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <How eyebrow={d.steps.eyebrow} h2Lead={d.steps.h2Lead} h2Accent={d.steps.h2Accent} intro={d.steps.intro} steps={hp.timeline.steps} placement="dhaka-steps" />

  <Fragment slot="after-reviews">
    <Related rel={d.services} published={pub.all} />
    <section class="relative pb-20 md:pb-28">
      <div class="mx-auto max-w-[1240px] px-4 md:px-6">
        <div class="pebble flex flex-col gap-4 rounded-[32px] bg-(--card) p-7 md:flex-row md:items-center md:p-10">
          <span class="blob-b flex size-14 shrink-0 items-center justify-center bg-(--blue-soft) text-(--blue-ink)"><Icon name="route" class="size-6" /></span>
          <div>
            <h2 class="text-2xl! md:text-3xl!">{d.beyond.h2}</h2>
            <p class="mt-2 text-lg">
              {d.beyond.text} <a href={interHref} class="font-medium text-(--blue-ink) underline underline-offset-4">{d.beyond.anchor}</a>.
            </p>
          </div>
        </div>
      </div>
    </section>
    <Faq items={faqs} eyebrow={d.faq.eyebrow} h2Lead={d.faq.h2Lead} h2Accent={d.faq.h2Accent} updated={d.updated} />
  </Fragment>

  <Final slot="end" h2Lead={d.final.h2Lead} h2Accent={d.final.h2Accent} text={d.final.text} placement="dhaka-final" />
</SiteLayout>
