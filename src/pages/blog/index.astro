---
/**
 * Blog index (/blog/). Lists published English posts, newest first.
 * SEO: while there are no posts the page is noindex (an empty list is thin content)
 * and stays out of the sitemap (astro.config.mjs). It becomes indexable on its own
 * once the first post is published. Every post must link to a money page (content.config.ts).
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import Final from '../../components/warm/Final.astro';
import { business, breadcrumbLd, graphLd, ids, organizationLd, services, websiteLd } from '../../data/business';
import { publishedPaths } from '../../lib/routes';

const posts = (await getCollection('blog', (e) => !e.data.draft && !e.data.noindex && e.data.lang === 'en')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);
const pub = await publishedPaths('en');
const serviceLinks = services.filter((s) => s.key !== 'emergency' && s.status === 'fact' && pub.all.has(s.path));

const slug = '/blog/';
const pageUrl = `${business.url}${slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: slug },
];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  {
    '@type': 'CollectionPage',
    '@id': pageUrl,
    url: pageUrl,
    name: 'Ambulance BD 24 Blog',
    inLanguage: 'en-BD',
    isPartOf: { '@id': ids.website },
    publisher: { '@id': ids.organization },
    breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
  },
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
);
---

<SiteLayout
  title="Ambulance Guides and News | Ambulance BD 24 Blog"
  description="Practical guides from the Ambulance BD 24 dispatch team in Dhaka: choosing the right ambulance, fares, hospital transfers and district trips."
  path={slug}
  jsonLd={jsonLd}
  crumbs={crumbs}
  noindex={posts.length === 0}
  mainClass="svc"
>
  <section class="px-3 pt-4 md:px-6 md:pt-6">
    <div class="relative isolate mx-auto max-w-[1400px] overflow-hidden rounded-[36px] bg-(--ink) text-white md:rounded-[64px]">
      <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_8%_0%,rgb(80_112_252/0.28),transparent_45%),radial-gradient(circle_at_100%_100%,rgb(80_112_252/0.18),transparent_40%)]"></div>
      <div class="mx-auto max-w-[1240px] px-4 py-10 md:px-10 md:py-14">
        <p class="inline-flex items-center gap-2.5 rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm text-white/85">
          <span class="size-2.5 rounded-full bg-(--blue)"></span>
          Blog
        </p>
        <h1 class="mt-6 text-white!">Ambulance guides from our dispatch team</h1>
        <p class="mt-5 max-w-2xl text-lg text-white/80">
          Plain answers to the questions families often ask us: which ambulance to choose, how fares work, and how to plan a hospital transfer or a trip to a district.
        </p>
        <p class="mt-6 text-white/80">Need an ambulance now? Don't read, call:</p>
        <a href={business.phone.tel} class="phone serif mt-1 inline-block text-[2.2rem] leading-tight text-white no-underline hover:underline md:text-[2.8rem]" data-placement="blog-hero">
          {business.phone.display}
        </a>
      </div>
    </div>
  </section>

  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      {
        posts.length > 0 ? (
          <>
            <h2>
              All <em>guides</em>
            </h2>
            <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((p) => (
                <li>
                  <a href={p.data.slug} class="pebble group flex h-full flex-col overflow-hidden rounded-[32px] bg-(--card) no-underline">
                    {p.data.cover ? (
                      <Image src={p.data.cover} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" class="aspect-[16/9] w-full object-cover" loading="lazy" />
                    ) : (
                      <span class="flex aspect-[16/9] w-full items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
                        <Icon name="ambulance" class="size-12" />
                      </span>
                    )}
                    <span class="flex grow flex-col p-7">
                      <time datetime={p.data.published.toISOString().slice(0, 10)} class="text-sm text-(--gray-ink)">
                        {fmt(p.data.published)}
                      </time>
                      <span class="serif mt-3 block text-2xl text-(--ink)">{p.data.h1}</span>
                      <span class="mt-2.5 block grow">{p.data.metaDescription}</span>
                      <span class="mt-6 inline-flex items-center gap-2 font-medium text-(--blue-ink)">
                        Read the guide
                        <Icon name="arrow-right" class="size-5 transition-transform group-hover:translate-x-1" />
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <>
            <h2>
              First articles <em>coming soon</em>
            </h2>
            <p class="mt-5 max-w-2xl text-lg">Our first guides are being written. Until then, these pages answer the most common questions.</p>
            <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {serviceLinks.map((s) => (
                <li>
                  <a href={s.path} class="pebble flex min-h-16 items-center justify-between gap-3 rounded-[24px] bg-(--card) px-6 py-4 font-medium text-(--ink) no-underline hover:text-(--blue-ink)">
                    {s.en}
                    <Icon name="arrow-right" class="size-5 shrink-0" />
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <Final slot="end" h2Lead="Need an" h2Accent="ambulance now?" text="Call and tell us where you are and how the patient is. We tell you the fare before we dispatch." placement="blog-final" showForm={false} />
</SiteLayout>
