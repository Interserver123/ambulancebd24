---
/**
 * Bangla service pages at /bn/ + the English path (hreflang bn-BD, paired with the English page).
 * Page copy: src/data/service-pages (lang: 'bn'). Sections and schema: components/service/ServicePageView.astro.
 */
import type { GetStaticPaths } from 'astro';
import '../../styles/fonts-bn.css';
import ServicePageView from '../../components/service/ServicePageView.astro';
import { servicePages } from '../../data/service-pages';
import type { ServicePage } from '../../data/service-pages/schema';

export const getStaticPaths = (() =>
  servicePages
    .filter((p) => p.lang === 'bn')
    .map((page) => ({ params: { service: page.slug.replace(/^\/bn\//, '').slice(0, -1) }, props: { page } }))) satisfies GetStaticPaths;

const { page } = Astro.props as { page: ServicePage };
---

<ServicePageView page={page} />
