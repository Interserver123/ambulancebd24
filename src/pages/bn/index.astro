---
/**
 * Bangla hub (/bn/): the Bangla entry point for emergency searches, paired with the English
 * homepage by hreflang. Copy: src/data/bn-hub.ts. Cards link to the Bangla service pages that
 * exist and to the English page otherwise (marked), so the hub never links to a 404.
 * Schema: WebPage + Organization + WebSite + FAQPage from the same faqs[].
 */
import '../../styles/fonts-bn.css';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Faq from '../../components/warm/Faq.astro';
import Final from '../../components/warm/Final.astro';
import { bnHub as d } from '../../data/bn-hub';
import { servicePages } from '../../data/service-pages';
import { business, faqPageLd, getService, graphLd, organizationLd, webPageLd, websiteLd } from '../../data/business';

const pageUrl = `${business.url}${d.slug}`;
const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  // Hub of the Bangla layer, like the homepage: no breadcrumb trail.
  (({ breadcrumb: _b, ...rest }) => rest)(webPageLd({ pageUrl, name: d.metaTitle, dateModified: d.updated, lang: 'bn' })),
  faqPageLd(d.faq.items, pageUrl),
);

const icons = { icu: 'heart-pulse', nicu: 'baby', ac: 'fan', freezer: 'snow', 'inter-district': 'route', air: 'ambulance' } as const;
const cards = d.services.cards.map((c) => {
  const s = getService(c.key);
  const bn = servicePages.find((p) => p.serviceKey === c.key && p.lang === 'bn');
  const en = servicePages.find((p) => p.serviceKey === c.key && p.lang === 'en')!;
  return { ...c, name: s.bn, href: (bn ?? en).slug, english: !bn, icon: icons[c.key] };
});
---

<SiteLayout
  title={d.metaTitle}
  description={d.metaDescription}
  path={d.slug}
  lang="bn"
  jsonLd={jsonLd}
  alternates={[{ hreflang: 'en-BD', path: '/' }]}
  xDefault="/"
  mainClass="svc"
  nap={d.nap}
>
  <ServiceHero hero={d.hero} crewVerified={false} placement="bn-hub-hero" lang="bn" altPath="/" />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.services.eyebrow}</p>
        <h2 class="mt-4">{d.services.h2Lead} <em>{d.services.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.services.intro}</p>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((c) => (
            <li>
              <a href={c.href} hreflang={c.english ? 'en' : undefined} class="pebble flex h-full flex-col gap-4 rounded-[32px] bg-(--card) p-7 text-(--ink) no-underline hover:text-(--blue-ink)">
                <span class="blob-a flex size-12 items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
                  <Icon name={c.icon} class="size-5" />
                </span>
                <h3>{c.name}{c.english ? ` ${d.services.englishNote}` : ''}</h3>
                <p class="text-lg">{c.text}</p>
                <span class="mt-auto inline-flex items-center gap-2 font-medium text-(--blue-ink)">
                  {d.services.more}: {c.name}
                  <Icon name="arrow-right" class="size-4" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative bg-(--tint) py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.fare.eyebrow}</p>
        <h2 class="mt-4">{d.fare.h2Lead} <em>{d.fare.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.fare.body}</p>
      </div>
    </div>
  </section>

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.areas.eyebrow}</p>
        <h2 class="mt-4">{d.areas.h2Lead} <em>{d.areas.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.areas.intro}</p>
      </div>
      <ul class="mt-10 flex flex-wrap gap-3">
        {
          d.areas.list.map((a) => (
            <li>
              <a href={a.path} hreflang="en" class="inline-flex min-h-12 items-center rounded-full bg-(--card) px-5 py-2 text-(--ink) no-underline soft-shadow hover:text-(--blue-ink)">
                {a.name} {d.areas.englishNote}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-lg">
        <a href={d.areas.allAreas.path} hreflang="en" class="font-medium text-(--blue-ink) underline underline-offset-4">{d.areas.allAreas.anchor} {d.areas.englishNote}</a>
      </p>
    </div>
  </section>

  <Fragment slot="after-reviews">
    <Faq items={d.faq.items} eyebrow={d.faq.eyebrow} h2Lead={d.faq.h2Lead} h2Accent={d.faq.h2Accent} updated={d.updated} lang="bn" />
  </Fragment>

  <Final slot="end" h2Lead={d.final.h2Lead} h2Accent={d.final.h2Accent} text={d.final.text} placement="bn-hub-final" lang="bn" />
</SiteLayout>
