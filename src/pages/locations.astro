---
/**
 * Locations hub (/locations/). Copy: src/data/locations.ts. District list: src/data/routes.ts
 * (division order) + src/data/district-pages (links). A district without a page shows as plain
 * text, so the hub never links to a 404.
 * Schema: WebPage + BreadcrumbList + ItemList (district pages) + FAQPage from the same faqs[].
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import Faq from '../components/warm/Faq.astro';
import Final from '../components/warm/Final.astro';
import { locations as d } from '../data/locations';
import { insideDhaka } from '../data/inside-dhaka';
import { routes } from '../data/routes';
import { business, breadcrumbLd, faqPageLd, getService, graphLd, organizationLd, webPageLd, websiteLd } from '../data/business';
import { publishedPaths } from '../lib/routes';

const pub = await publishedPaths('en');
const pageUrl = `${business.url}${d.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.breadcrumb, path: d.slug },
];
const faqs = d.faq.items;
const inter = getService('inter-district');
const interHref = pub.all.has(inter.path) ? inter.path : undefined;
const dhakaHref = pub.all.has(insideDhaka.slug) ? insideDhaka.slug : undefined;

// Division groups in a stable order; within a division, districts with a page first.
const divisionOrder = ['Dhaka', 'Chattogram', 'Khulna', 'Barishal', 'Rajshahi', 'Rangpur', 'Sylhet', 'Mymensingh'];
const groups = divisionOrder
  .map((division) => ({
    division,
    items: routes
      .filter((r) => r.division === division)
      .map((r) => ({ name: r.district, aka: r.aka, href: pub.districts.get(r.district) }))
      .sort((a, b) => Number(Boolean(b.href)) - Number(Boolean(a.href)) || a.name.localeCompare(b.name)),
  }))
  .filter((g) => g.items.length > 0);
const pageUrls = groups.flatMap((g) => g.items.flatMap((i) => (i.href ? [`${business.url}${i.href}`] : [])));

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  webPageLd({ pageUrl, name: d.metaTitle, dateModified: d.updated, type: 'CollectionPage' }),
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#districts`,
    name: 'District ambulance pages',
    itemListElement: pageUrls.map((url, i) => ({ '@type': 'ListItem', position: i + 1, url })),
  },
  faqPageLd(faqs, pageUrl),
);
---

<SiteLayout title={d.metaTitle} description={d.metaDescription} path={d.slug} jsonLd={jsonLd} crumbs={crumbs} mainClass="svc" nap={d.nap}>
  <ServiceHero hero={d.hero} crewVerified={false} placement="locations-hero" />

  {
    dhakaHref && (
      <section class="relative pt-20 md:pt-28">
        <div class="mx-auto max-w-[1240px] px-4 md:px-6">
          <div class="pebble flex flex-col gap-5 rounded-[32px] bg-(--card) p-7 md:flex-row md:items-center md:p-10">
            <span class="blob-a flex size-14 shrink-0 items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
              <Icon name="ambulance" class="size-6" />
            </span>
            <div>
              <p class="eyebrow-warm">{d.dhaka.eyebrow}</p>
              <h2 class="mt-2">
                {d.dhaka.h2Lead} <em>{d.dhaka.h2Accent}</em>
              </h2>
              <p class="mt-3 text-lg">
                {d.dhaka.text}{' '}
                <a href={dhakaHref} class="font-medium text-(--blue-ink) underline underline-offset-4">{d.dhaka.anchor}</a>.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.districts.eyebrow}</p>
        <h2 class="mt-4">{d.districts.h2Lead} <em>{d.districts.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.districts.intro}</p>
      </div>
      <div class="mt-12 grid gap-10 md:grid-cols-2 lg:grid-cols-3">
        {
          groups.map((g) => (
            <div>
              <h3>{g.division} division</h3>
              <ul class="mt-4 space-y-2">
                {g.items.map((i) => (
                  <li>
                    {i.href ? (
                      <a href={i.href} class="flex min-h-12 items-center justify-between gap-3 rounded-[18px] bg-(--card) px-4 py-2.5 text-(--ink) no-underline soft-shadow hover:text-(--blue-ink)">
                        <span>
                          Ambulance service in {i.name}
                          {i.aka && <span class="block text-sm text-(--gray-ink)">{i.aka}</span>}
                        </span>
                        <Icon name="arrow-right" class="size-4 shrink-0 text-(--blue-ink)" />
                      </a>
                    ) : (
                      <span class="flex min-h-12 items-center justify-between gap-3 rounded-[18px] border border-dashed border-(--line) px-4 py-2.5 text-(--ink)">
                        {i.name}
                        <span class="text-sm text-(--gray-ink)">{d.districts.noPage}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-12 max-w-3xl text-lg">{d.districts.missing}</p>
      {
        interHref && (
          <p class="mt-4 text-lg">
            {d.districts.hubLead}{' '}
            <a href={interHref} class="font-medium text-(--blue-ink) underline underline-offset-4">{d.districts.hubAnchor}</a>.
          </p>
        )
      }
    </div>
  </section>

  <Fragment slot="after-reviews">
    <Faq items={faqs} eyebrow={d.faq.eyebrow} h2Lead={d.faq.h2Lead} h2Accent={d.faq.h2Accent} updated={d.updated} />
  </Fragment>

  <Final slot="end" h2Lead={d.final.h2Lead} h2Accent={d.final.h2Accent} text={d.final.text} placement="locations-final" />
</SiteLayout>
