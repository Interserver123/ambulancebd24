---
/**
 * Services hub (/services/). Copy: src/data/services-hub.ts. Cards come from the published
 * English service pages (src/data/service-pages), so the hub never links to a 404 and a new
 * service page shows up here on its own.
 * Schema: WebPage + BreadcrumbList + ItemList (service pages) + FAQPage from the same faqs[].
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ServiceHero from '../components/service/ServiceHero.astro';
import Faq from '../components/warm/Faq.astro';
import Final from '../components/warm/Final.astro';
import { servicesHub as d, choose } from '../data/services-hub';
import { servicePages } from '../data/service-pages';
import { business, breadcrumbLd, faqPageLd, getService, graphLd, organizationLd, services, webPageLd, websiteLd } from '../data/business';

const pageUrl = `${business.url}${d.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: d.breadcrumb, path: d.slug },
];
const faqs = d.faq.items;

// Catalogue order, English pages only.
const pages = servicePages.filter((p) => p.lang === 'en');
const cards = services.flatMap((s) => {
  const p = pages.find((x) => x.serviceKey === s.key);
  return p ? [{ key: s.key, name: s.en, href: p.slug, text: p.hero.lede }] : [];
});
const guide = choose.flatMap((c) => {
  const p = pages.find((x) => x.serviceKey === c.key);
  return p ? [{ need: c.need, name: getService(c.key).en, href: p.slug }] : [];
});
const icons: Record<string, 'heart-pulse' | 'baby' | 'fan' | 'snow' | 'route' | 'ambulance'> = {
  icu: 'heart-pulse',
  nicu: 'baby',
  ac: 'fan',
  freezer: 'snow',
  'inter-district': 'route',
};

const jsonLd = graphLd(
  organizationLd(),
  websiteLd(),
  webPageLd({ pageUrl, name: d.metaTitle, dateModified: d.updated }),
  breadcrumbLd(
    pageUrl,
    crumbs.map((c) => ({ name: c.name, url: `${business.url}${c.path}` })),
  ),
  {
    '@type': 'ItemList',
    '@id': `${pageUrl}#services`,
    name: 'Ambulance services',
    itemListElement: cards.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${business.url}${c.href}` })),
  },
  faqPageLd(faqs, pageUrl),
);
---

<SiteLayout title={d.metaTitle} description={d.metaDescription} path={d.slug} jsonLd={jsonLd} crumbs={crumbs} mainClass="svc" nap={d.nap}>
  <ServiceHero hero={d.hero} crewVerified={false} placement="services-hero" />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.cards.eyebrow}</p>
        <h2 class="mt-4">{d.cards.h2Lead} <em>{d.cards.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.cards.intro}</p>
      </div>
      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          cards.map((c) => (
            <li>
              <a href={c.href} class="pebble flex h-full flex-col gap-4 rounded-[32px] bg-(--card) p-7 text-(--ink) no-underline hover:text-(--blue-ink)">
                <span class="blob-a flex size-12 items-center justify-center bg-(--blue-soft) text-(--blue-ink)">
                  <Icon name={icons[c.key] ?? 'ambulance'} class="size-5" />
                </span>
                <h3>{c.name}</h3>
                <p class="text-lg">{c.text}</p>
                <span class="mt-auto inline-flex items-center gap-2 font-medium text-(--blue-ink)">
                  {d.cards.more}: {c.name}
                  <Icon name="arrow-right" class="size-4" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative bg-(--tint) py-20 md:py-28">
    <div class="mx-auto max-w-[1240px] px-4 md:px-6">
      <div class="max-w-3xl">
        <p class="eyebrow-warm">{d.choose.eyebrow}</p>
        <h2 class="mt-4">{d.choose.h2Lead} <em>{d.choose.h2Accent}</em></h2>
        <p class="mt-6 text-xl text-(--ink)">{d.choose.intro}</p>
      </div>
      <ul class="mt-10 grid gap-3 md:grid-cols-2">
        {
          guide.map((g) => (
            <li>
              <a href={g.href} class="flex min-h-14 items-center justify-between gap-4 rounded-[20px] bg-(--card) px-5 py-3 text-(--ink) no-underline soft-shadow hover:text-(--blue-ink)">
                <span>
                  {g.need}
                  <span class="block text-sm font-medium text-(--blue-ink)">{g.name}</span>
                </span>
                <Icon name="arrow-right" class="size-4 shrink-0 text-(--blue-ink)" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-lg">{d.choose.airNote}</p>
    </div>
  </section>

  <Fragment slot="after-reviews">
    <Faq items={faqs} eyebrow={d.faq.eyebrow} h2Lead={d.faq.h2Lead} h2Accent={d.faq.h2Accent} updated={d.updated} />
  </Fragment>

  <Final slot="end" h2Lead={d.final.h2Lead} h2Accent={d.final.h2Accent} text={d.final.text} placement="services-final" />
</SiteLayout>
